! X11 Cursor Theme & Size
Xcursor.theme: Kaela-Kovalskia-v2
Xcursor.size: 24

! Font rendering hints for Xft-aware applications
Xft.antialias: 1
Xft.hinting: 1
Xft.hintstyle: hintslight
Xft.rgba: rgb
Xft.lcdfilter: lcddefault

*.background:  #282828
*.foreground:  #ebdbb2
*.cursorColor: #fbf1c7

! Black / Grey
*.color0:      #282828
*.color8:      #928374

! Red
*.color1:      #cc241d
*.color9:      #fb4934

! Green
*.color2:      #98971a
*.color10:     #b8bb26

! Yellow
*.color3:      #d79921
*.color11:     #fabd2f

! Blue
*.color4:      #458588
*.color12:     #83a598

! Magenta
*.color5:      #b16286
*.color13:     #d3869b

! Cyan
*.color6:      #689d6a
*.color14:     #8ec07c

! White
*.color7:      #a89984
*.color15:     #ebdbb2
