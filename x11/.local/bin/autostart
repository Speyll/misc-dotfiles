#!/bin/sh

CONFIG="$HOME/.config/autostart.env"
[ -f "$CONFIG" ] && . "$CONFIG"

# Safe log fallback if $LOG is not defined in env
LOG="${LOG:-$HOME/.cache/autostart.log}"
exec >> "$LOG" 2>&1
echo "=== Autostart: $(date) ==="

# 1. Cleanup old instances
killall -q flavours mpvpaper feh dunst redshift clipcatd openrgb sunshine lxqt-policykit-agent
sleep 1

# 2. Environment & Auth
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
    eval "$(gnome-keyring-daemon --start --components=secrets)"
fi

# Polkit Agent Handoff
if ! pgrep -f "(pol|policy)kit.*agent" >/dev/null; then
    # 1. Direct binary execution for LXQt (no native systemd unit)
    if command -v lxqt-policykit-agent >/dev/null 2>&1; then
        lxqt-policykit-agent &

    # 2. Systemd path for agents that ship unit files
    elif [ -d /run/systemd/system ]; then
        systemctl --user start hyprpolkitagent.service 2>/dev/null || \
        systemctl --user start plasma-polkit-agent.service 2>/dev/null || \
        systemctl --user start polkit-gnome-authentication-agent-1.service 2>/dev/null

    # 3. Non-systemd fallback path
    else
        for agent in \
            /usr/libexec/hyprpolkitagent \
            /usr/lib/polkit-kde-authentication-agent-1 \
            /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
            /usr/libexec/polkit-gnome-authentication-agent-1; do
            if [ -f "$agent" ]; then
                "$agent" &
                break
            fi
        done
    fi
fi

# 3. Interface & Non-blocking D-Bus update
gsettings set org.gnome.desktop.interface cursor-theme "${CURSOR:-Adwaita}" 2>/dev/null
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null

# Import X11 environment into DBus in the background so it cannot block script execution
(dbus-update-activation-environment --systemd DISPLAY XAUTHORITY 2>/dev/null) &

# 4. Launch Services & Wallpaper FIRST
[ -x "$HOME/.local/bin/autostart-services" ] && "$HOME/.local/bin/autostart-services" &
[ -x "$HOME/.local/bin/autostart-wallpaper" ] && "$HOME/.local/bin/autostart-wallpaper" &

# 5. Delayed Tasks
[ "$UPDATE_SCAN" = "true" ] && (sleep 10; "$HOME/.local/bin/updtscan") &
