{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 6,
    "reload_style_on_change": true,

    "modules-center": [
        "custom/launcher",
        "wireplumber",
        "clock",
        "battery",
        "tray"
    ],

    "custom/launcher": {
        "format": "",
        "on-click": "fuzzel",
        "tooltip": false
    },

    "wireplumber": {
        "format": " {volume}%",
        "format-muted": "",
        "on-click": "pavucontrol",
        "scroll-step": 0.2,
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "interval": 60,
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": "🔌 {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false
    },

    "tray": {
        "icon-size": 15,
        "spacing": 6
    }
}
